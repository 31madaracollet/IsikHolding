# ── Supabase ────────────────────────────────────────────────────────────────
# Supabase → Project Settings → API ekranından alın.
# Boş bırakılırsa site "demo modunda" çalışır; formlar ve sepet akışı
# gerçek veritabanına yazmadan başarıyla tamamlanır.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnızca sunucuda kullanılır; istemciye asla sızdırılmamalı.
SUPABASE_SERVICE_ROLE_KEY=
# Sunucu *.supabase.co'ya ulaşamazsa (kısıtlı önizleme ağları) istemci,
# anon anahtarıyla RLS destekli INSERT köprüsünü kullanır. Bkz. README.

# ── GitHub ──────────────────────────────────────────────────────────────────
# Hakkımızda sayfasındaki açık kaynak kartını besler.
NEXT_PUBLIC_GITHUB_REPO=31madaracollet/IsikHolding
# Opsiyonel: rate limit'e takılmamak için fine-grained read-only token.
GITHUB_TOKEN=

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://isikholding.com
